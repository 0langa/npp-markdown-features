#include <winver.h>
#include "PluginResources.h"
#include "PluginVersion.h"

// highlight.js v11.9.0 (BSD-3-Clause, see third_party/highlight/LICENSE).
IDR_NMF_HLJS RCDATA "../../third_party/highlight/highlight.min.js"

// Notepad++ Plugins Admin requires the DLL file version to match the listed version.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION NMF_VERSION_MAJOR,NMF_VERSION_MINOR,NMF_VERSION_PATCH,0
 PRODUCTVERSION NMF_VERSION_MAJOR,NMF_VERSION_MINOR,NMF_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "0langa"
            VALUE "FileDescription", "Markdown Features plugin for Notepad++"
            VALUE "FileVersion", NMF_VERSION_STRING
            VALUE "InternalName", "NppMarkdownFeatures"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "NppMarkdownFeatures.dll"
            VALUE "ProductName", "NppMarkdownFeatures"
            VALUE "ProductVersion", NMF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
